{
  "name": "@geeksium/pos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Geeksium POS — API propia (Node.js + TypeScript + Fastify + PostgreSQL)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/check-layering.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
