# ---------------------------------------------------------------------------
# Geeksium POS — API. Copiar a .env y ajustar. NUNCA versionar el .env real.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL. Hoy Supabase (usado como PostgreSQL administrado), mañana AWS RDS/Aurora.
# El string de conexión es lo único que cambia en la migración.
DATABASE_URL=postgres://usuario:password@localhost:5432/geeksium_pos
DATABASE_SSL=false

# Secreto de firma de los access tokens (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Vida de los tokens
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cookie del refresh token.
# COOKIE_SECURE debe ser true en producción (el arranque falla si no lo es).
# Solo se permite false para desarrollo local sobre http://localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Backoff de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_MAX_SECONDS=900

# ---------------------------------------------------------------------------
# Seed de desarrollo. Solo lo lee `npm run seed:dev`; jamás producción.
# El script aborta con NODE_ENV=production y exige ALLOW_DEV_SEED=true.
# ---------------------------------------------------------------------------
# Bandera de confirmación explícita. Sin ella el seed no hace nada.
ALLOW_DEV_SEED=false
# Contraseñas demo opcionales. Si se dejan vacías se generan al azar y se
# imprimen UNA sola vez en consola.
SEED_OWNER_PASSWORD=OWNERsHMq35a45Xw1TfRoIVj0rW
SEED_CASHIER_PASSWORD=
# Restablecer las contraseñas demo de usuarios ya existentes.
SEED_RESET_PASSWORDS=false

# ---------------------------------------------------------------------------
# Pruebas de integración contra PostgreSQL real (`npm test`).
# Si no se define, las pruebas de integración se saltan.
# Debe apuntar a una base DESECHABLE con las migraciones aplicadas.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=
TEST_DATABASE_SSL=false
