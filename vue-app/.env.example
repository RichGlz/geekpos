# ---------------------------------------------------------------------------
# Geeksium POS — App Vue. Copiar a .env.local y ajustar.
# Solo las variables VITE_* llegan al navegador: NUNCA pongas secretos aquí,
# todo lo que se escriba en este archivo acaba en el bundle público.
# ---------------------------------------------------------------------------

# Base de la API propia (Fastify escucha por defecto en el puerto 3000).
#  - Ruta relativa (recomendada en desarrollo): el dev server hace proxy y el
#    navegador ve mismo origen, así la cookie HttpOnly del refresh viaja sin
#    configuración extra de CORS.
#  - URL absoluta (despliegues con API en otro dominio): exige que el backend
#    liste ese origen en CORS_ORIGINS y use COOKIE_SAMESITE=none + COOKIE_SECURE=true.
VITE_API_BASE_URL=/api/v1

# Destino del proxy del dev server de Vite cuando VITE_API_BASE_URL es relativa.
VITE_API_PROXY=http://localhost:3000

# Modo mock: sirve datos simulados sin API levantada. SOLO DESARROLLO.
# Se ignora en cualquier build de producción y muestra el banner permanente
# "MODO MOCK — SOLO UI" para que nadie confunda la demo con datos reales.
VITE_USE_MOCKS=false
