{
  "name": "@geeksium/pos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Geeksium POS — PWA de producción (Vue 3 + Vite + TypeScript + Pinia + Tailwind)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
